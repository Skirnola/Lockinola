# Local AI: install Ollama, then run `ollama pull qwen3.8:27b`.
# Hosted AI: use an Ollama API key stored as a Cloudflare Worker secret.
LOCKINOLA_AI_PROVIDER=ollama
OLLAMA_LOCAL_MODEL=qwen3.8:27b
OLLAMA_CLOUD_MODEL=gemma4
OLLAMA_API_KEY=
# Optional override. Local and hosted defaults are selected automatically.
# OLLAMA_BASE_URL=http://127.0.0.1:11434/api
LOCKINOLA_AI_DAILY_LIMIT=20

# Optional OpenAI fallback. Set LOCKINOLA_AI_PROVIDER=openai to use it.
OPENAI_API_KEY=
OPENAI_TUTOR_MODEL=gpt-5.6-luna

# Leave false for normal local use. Hosted mode fails closed until both access
# values meet the minimum lengths. Keep the real values only in the host's
# secret environment; never commit them.
LOCKINOLA_HOSTED=false
LOCKINOLA_ACCESS_PASSWORD=
LOCKINOLA_ACCESS_SECRET=

# Optional local Python runner overrides.
# LOCKINOLA_PYTHON_PATH=C:\Program Files\Python314\python.exe
# LOCKINOLA_RUNNER_PORT=4317
